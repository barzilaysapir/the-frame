# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Catalog/marketing images in public/ aren't content-hashed (unlike
# /_next/static), so a moderate max-age instead of "immutable" — a
# same-URL asset replacement is still picked up within a day.
/*.jpg
  Cache-Control: public,max-age=86400
/*.png
  Cache-Control: public,max-age=86400

# Public course promo clips (not content-hashed). Same one-day cache as
# catalog images so a same-URL replacement is picked up within a day.
/course-promos/*
  Cache-Control: public,max-age=86400

# Tiny uPay return hop (no Worker). Short cache so a script tweak is picked up.
/pay-return.html
  Cache-Control: public,max-age=3600
