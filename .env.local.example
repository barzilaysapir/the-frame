# Firebase Authentication (Google + phone number sign-in)
#
# 1. Create a project at https://console.firebase.google.com
# 2. Add a Web App to the project to get these config values
#    (Project settings -> General -> Your apps -> SDK setup and configuration)
# 3. Enable the "Google" and "Phone" sign-in providers under
#    Authentication -> Sign-in method
# 4. Add this app's domain(s) to Authentication -> Settings -> Authorized domains
#
# These values are safe to expose to the browser (that's what NEXT_PUBLIC_
# means), but the project still won't work without them configured. In
# production (Cloudflare Workers), set the same variables via `wrangler`
# secrets/vars or the Cloudflare dashboard.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
