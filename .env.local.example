# Firebase Authentication (Google first, phone optional)
#
# 1. Open https://console.firebase.google.com and select your project
# 2. Project settings → General → Your apps → add a Web app (</>) if needed
# 3. Copy the firebaseConfig values into the NEXT_PUBLIC_* vars below
# 4. Authentication → Sign-in method → enable Google (and Phone if you want SMS)
# 5. Authentication → Settings → Authorized domains:
#    - localhost
#    - your Cloudflare Workers preview hostname
#    - your production domain (when ready)
#
# These values are safe to expose to the browser (NEXT_PUBLIC_), but auth
# will not work until they are set for the environment that runs `next build`
# (local `.env.local`, Cloudflare Workers Builds vars, etc.).
#
# Server-side `/api/v1/me*` verifies Firebase ID tokens with Google JWKS using
# NEXT_PUBLIC_FIREBASE_PROJECT_ID (no Admin SDK / service account required).
#
# After filling this file locally, restart `next dev`.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical public URL (metadataBase, sitemap.xml, robots.txt). Leave
# empty to use the live Cloudflare Worker
# (https://the-frame.barzilaysapir.workers.dev). Set this to
# https://theframe.bybarzilay.com after that custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# The Frame's business Instagram — shown as the footer social icon (see
# lib/social.ts) and as the second contact method on
# app/[locale]/contact/page.tsx (uPay Bit/Diners compliance requires at
# least two). Safe to expose to the browser; also set as a Cloudflare
# Workers Build variable for production (same rule as the Firebase vars
# above).
NEXT_PUBLIC_INSTAGRAM_URL=
