{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Runs automatically before `wrangler dev`/`wrangler deploy`, so the Worker
	// still gets an OpenNext build even if the CI trigger's own "build
	// command" step is empty or just runs `next build`. Calls the OpenNext
	// CLI directly (not `npm run build`) to avoid recursing back into this
	// hook via the "build" npm script.
	// See https://developers.cloudflare.com/workers/wrangler/custom-builds/
	"build": {
		"command": "npx opennextjs-cloudflare build"
	},
	"main": ".open-next/worker.js",
	"name": "the-frame",
	"account_id": "8739cda6b7162b44320b8f637feb219a",
	"routes": [
		{
			"pattern": "theframe.bybarzilay.com",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "the-frame"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Single app D1: catalog + users + purchases (physical name still the-frame-catalog).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "the-frame-catalog",
			"database_id": "841f01c5-b3c3-4b8c-8891-da5cd2c9b2de",
			"migrations_dir": "migrations"
		}
	]
}
