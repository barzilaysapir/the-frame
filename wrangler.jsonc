{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Runs automatically before `wrangler dev`/`wrangler deploy`, so the Worker
	// still gets an OpenNext build even if the CI trigger's own "build
	// command" step is empty or just runs `next build`. Calls the OpenNext
	// CLI directly (not `npm run build`) to avoid recursing back into this
	// hook via the "build" npm script.
	// See https://developers.cloudflare.com/workers/wrangler/custom-builds/
	"build": {
		"command": "npx opennextjs-cloudflare build"
	},
	"main": ".open-next/worker.js",
	"name": "the-frame",
	"account_id": "8739cda6b7162b44320b8f637feb219a",
	"routes": [
		{
			"pattern": "theframe.bybarzilay.com",
			"custom_domain": true
		}
	],
	// Fallback so the Worker is reachable at https://the-frame.<subdomain>.workers.dev
	// even while the custom domain above has no DNS record attached (confirmed via
	// `nslookup`: NXDOMAIN as of 2026-08-13 — a separate, pre-existing issue).
	"workers_dev": true,
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "the-frame"
		}
	],
	// Single app D1: catalog + users + purchases (physical name still the-frame-catalog).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "the-frame-catalog",
			"database_id": "841f01c5-b3c3-4b8c-8891-da5cd2c9b2de",
			"migrations_dir": "migrations"
		}
	],
	// ISR/data-cache incremental cache for catalog `revalidate`d routes (see
	// open-next.config.ts). Kept on Workers KV rather than R2 even now that
	// R2 is enabled (see r2_buckets below) for the video-lesson bucket — no
	// reason to migrate a working cache layer for an unrelated feature. See
	// https://opennext.js.org/cloudflare/caching.
	//
	// No Durable Object queue binding here (deliberately) — see the comment
	// in open-next.config.ts for why it was dropped.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "63dd1b68c52d4367bd9526fb90c31b0a"
		}
	],
	// Private bucket for real (non-mock) external-course video lessons —
	// gated behind Firebase login via a signed short-lived playback URL, see
	// lib/server/course-videos.ts. Public access must stay disabled on this
	// bucket; the app is the only thing that ever reads from it.
	"r2_buckets": [
		{
			"binding": "COURSE_VIDEOS",
			"bucket_name": "the-frame-class-videos",
			// Real lesson files live in the remote bucket; local Miniflare R2
			// is empty, so next/wrangler local dev must proxy reads remotely
			// (D1 stays local — do not set remote on the DB binding).
			"remote": true
		}
	],
	// Guards the /me* write endpoints (see lib/server/api/rate-limit.ts) against
	// a single account hammering profile/favorites writes. Per-PoP and
	// eventually consistent by design — not an accounting system, just abuse
	// mitigation. https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	"ratelimits": [
		{
			"name": "ME_WRITE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
