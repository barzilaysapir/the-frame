{
  "name": "the-frame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "predev": "wrangler d1 migrations apply the-frame-catalog --local",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "prepreview": "wrangler d1 migrations apply the-frame-catalog --local",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:mock-catalog": "node scripts/generate-mock-catalog.ts",
    "verify:mock-db-parity": "node scripts/verify-mock-db-parity.ts",
    "compress:generated-media": "node scripts/compress-generated-media.mjs",
    "db:migrate:local": "wrangler d1 migrations apply the-frame-catalog --local",
    "db:migrate:remote": "wrangler d1 migrations apply the-frame-catalog --remote",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload -- --keep-vars"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^12.17.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.462.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "knip": "^6.32.2",
    "postcss": "^8.4.39",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
