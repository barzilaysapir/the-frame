# Wrangler-only local secrets (read by `wrangler dev` / `next dev` via the
# OpenNext Cloudflare platform proxy, and by `npm run preview`). Unlike
# .env.local, these are never exposed to the browser — server-only.
#
# Copy this file to `.dev.vars` (gitignored) and fill in a real value.
# `.dev.vars` is NOT read in production — for that, `npx wrangler secret put`
# the same names (`VIDEO_SIGNING_SECRET`, `R2_ACCESS_KEY_ID`, …).

# Signs/verifies HMAC fallback playback URLs (`.../stream`) used when the
# R2 S3 API token below is not set. Real (non-mock) class videos live in
# the private R2 bucket `the-frame` — see lib/server/course-videos.ts.
# Any long random string works; generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
VIDEO_SIGNING_SECRET=

# S3 API token for the `the-frame` R2 bucket (Dashboard → R2 → Manage
# R2 API Tokens). Object Read on `the-frame` only. `/stream` 307s to a
# short-lived GET so the browser streams from R2 instead of through the
# Worker (proxying a class MP4 hits error 1102).
#
# Prefer FRAME_R2_* names (OpenNext reserves R2_ACCESS_KEY_ID /
# R2_SECRET_ACCESS_KEY for its rclone cache tooling). Legacy R2_* still
# works as a fallback. Set on each Worker name (PR previews ≠ the-frame):
#   npx wrangler secret put FRAME_R2_ACCESS_KEY_ID --name <worker>
#   npx wrangler secret put FRAME_R2_SECRET_ACCESS_KEY --name <worker>
# After the first deploy, apply CORS:
#   npx wrangler r2 bucket cors set the-frame --file r2-cors.json
# Optional overrides (defaults match wrangler.jsonc):
# R2_ACCOUNT_ID=8541729902392a145a03f97a906af16f
# R2_BUCKET_NAME=the-frame
FRAME_R2_ACCESS_KEY_ID=
FRAME_R2_SECRET_ACCESS_KEY=

# Class playback requires the S3 token above. Set to 0 only to disable
# presign (playback will 503 — there is no Worker-proxy fallback).
# R2_PRESIGN_PLAYBACK=0

# Gates the `/api/preview?token=...` link that unlocks the demo/mock catalog
# (routines, instructors) — hidden by default everywhere, including this
# local dev server, once migration 0027 is applied. See lib/preview.ts and
# app/api/preview/route.ts. Any long random string works (same generator as
# above). Leave unset to disable the preview link entirely.
PREVIEW_CATALOG_TOKEN=

# Comma-separated list of Firebase-verified emails allowed onto the admin
# purchases page (app/[locale]/admin/purchases) — the manual "mark Bit
# payment as paid/refunded" tool for Phase 1. See lib/server/admin.ts.
# Missing/empty means nobody is an admin, not "allow everyone".
ADMIN_EMAILS=

# uPay (upay.co.il) — see lib/server/payments/upay.ts. The live dashboard
# button email is hardcoded as theframe@bybarzilay.com (public embed field,
# not a password). This secret is optional leftover config.
UPAY_MERCHANT_EMAIL=
