# Wrangler-only local secrets (read by `wrangler dev` / `next dev` via the
# OpenNext Cloudflare platform proxy, and by `npm run preview`). Unlike
# .env.local, these are never exposed to the browser — server-only.
#
# Copy this file to `.dev.vars` (gitignored) and fill in a real value.
# `.dev.vars` is NOT read in production — for that, set the same name as a
# Worker secret: `npx wrangler secret put VIDEO_SIGNING_SECRET`.

# Signs/verifies the short-lived playback URLs used to gate real (non-mock)
# external-course video lessons stored in the private R2 bucket
# `the-frame-class-videos` — see lib/server/course-videos.ts. Any long random
# string works; generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
VIDEO_SIGNING_SECRET=

# Gates the `/api/preview?token=...` link that unlocks the demo/mock catalog
# (routines, instructors) — hidden by default everywhere, including this
# local dev server, once migration 0027 is applied. See lib/preview.ts and
# app/api/preview/route.ts. Any long random string works (same generator as
# above). Leave unset to disable the preview link entirely.
PREVIEW_CATALOG_TOKEN=

# Comma-separated list of Firebase-verified emails allowed onto the admin
# purchases page (app/[locale]/admin/purchases) — the manual override for
# missed webhooks, refunds, or off-platform payments. See lib/server/admin.ts.
# Missing/empty means nobody is an admin, not "allow everyone".
ADMIN_EMAILS=

# Takbull (takbull.co.il) — see lib/server/payments/takbull.ts. Create a
# merchant account, then ask support for API_Key + API_Secret. Leave unset
# to skip offering Takbull (checkout then shows the "contact us" fallback).
#
# Confirm with Takbull that the ₪0 monthly plan includes website API +
# Google Pay (their main price list also lists Google Pay as a +₪25/mo add-on).
# Point IPN at {NEXT_PUBLIC_SITE_URL}/api/v1/webhooks/takbull
TAKBULL_API_KEY=
TAKBULL_API_SECRET=
