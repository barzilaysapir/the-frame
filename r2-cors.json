{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-none-match", "if-modified-since"]
      },
      "exposeHeaders": [
        "accept-ranges",
        "content-length",
        "content-range",
        "content-type",
        "etag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
